{
    "name": "kanbanflow-mcp-server",
    "version": "2.0.0",
    "description": "Multi-board Model Context Protocol (MCP) server for KanbanFlow - manage multiple boards, tasks, and workflows from Claude via a board_name parameter and a boards.json config file",
    "main": "build/index.js",
    "type": "module",
    "bin": {
        "kanbanflow-mcp-server": "./build/index.js"
    },
    "scripts": {
        "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
        "start": "node build/index.js",
        "dev": "tsc && node build/index.js",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "build",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "mcp",
        "model-context-protocol",
        "kanbanflow",
        "kanban",
        "cursor",
        "claude",
        "ai",
        "productivity",
        "task-management"
    ],
    "author": "Tim Williams",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/timaw513/kanbanflow-MCP"
    },
    "homepage": "https://github.com/timaw513/kanbanflow-MCP#readme",
    "bugs": {
        "url": "https://github.com/timaw513/kanbanflow-MCP/issues"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.4.0",
        "axios": "^1.7.9",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "typescript": "^5.7.2"
    }
}
